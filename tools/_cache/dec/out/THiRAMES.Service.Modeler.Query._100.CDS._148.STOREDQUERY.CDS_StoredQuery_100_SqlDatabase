SELECT C.*, dbo.FN_USERNAME(C.SITEID, C.CREATOR) AS CREATOR2, dbo.FN_USERNAME(C.SITEID, C.MODIFIER) AS MODIFIER2
FROM CIM_STOREDQUERY C
WHERE (:STOREDQUERYID = '' OR STOREDQUERYID LIKE :STOREDQUERYID + '%')
      AND (:STOREDQUERYNAME = '' OR STOREDQUERYNAME LIKE :STOREDQUERYNAME + '%')
      AND (:ISUSABLE = '' OR ISUSABLE = :ISUSABLE)
      AND SITEID = :SITEID