SELECT C.*, dbo.FN_USERNAME(C.SITEID, C.CREATOR) AS CREATOR2, dbo.FN_USERNAME(C.SITEID, C.MODIFIER) AS MODIFIER2
FROM CIM_PRODUCTCLASS C
WHERE (:PRODUCTCLASSID ='' OR PRODUCTCLASSID LIKE :PRODUCTCLASSID + '%')
      AND (:PRODUCTCLASSNAME ='' OR PRODUCTCLASSNAME LIKE :PRODUCTCLASSNAME + '%')
      AND (:ISUSABLE ='' OR ISUSABLE = :ISUSABLE)
      AND SITEID = :SITEID