SELECT C.*, dbo.FN_USERNAME(C.SITEID, C.CREATOR) AS CREATOR2, dbo.FN_USERNAME(C.SITEID, C.MODIFIER) AS MODIFIER2
FROM CIM_EQUIPMENTCLASS C
WHERE (:EQUIPMENTCLASSID = '' OR EQUIPMENTCLASSID LIKE :EQUIPMENTCLASSID + '%')
      AND (:EQUIPMENTCLASSNAME = '' OR EQUIPMENTCLASSNAME LIKE :EQUIPMENTCLASSNAME + '%')
      AND (:ISUSABLE = '' OR ISUSABLE = :ISUSABLE)
      AND SITEID = :SITEID