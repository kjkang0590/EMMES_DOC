SELECT A.CODE,
	   A.NAME
  FROM (
  	    SELECT 'IQC,PQC,OQC' AS INSPTYPE,
  	    	   '-' AS CODE,
  	    	   '-' AS NAME
  	    UNION ALL
  	    SELECT 'PQC,OQC' AS INSPTYPE,
  	    	   CUSTOMERID AS CODE,
	   		   CUSTOMERNAME AS NAME
		  FROM CIM_CUSTOMER
		 WHERE ISUSABLE='Usable' 
		   AND SITEID = :SITEID
		   AND (:COPERATORTYPE = '' OR CUSTOMERTYPE = :COPERATORTYPE)
		UNION ALL  
		SELECT 'IQC' AS INSPTYPE,
			   VENDORID AS CODE,
			   VENDORNAME AS NAME
		  FROM CIM_VENDOR
		 WHERE ISUSABLE ='Usable' 
		   AND SITEID = :SITEID
		   AND (:COPERATORTYPE = '' OR VENDORTYPE = :COPERATORTYPE)
	   ) A
 WHERE (:INSPTYPE = '' OR A.INSPTYPE LIKE '%' + :INSPTYPE + '%')