SELECT C.*, dbo.FN_USERNAME(C.SITEID, C.CREATOR) AS CREATOR2, dbo.FN_USERNAME(C.SITEID, C.MODIFIER) AS MODIFIER2
  FROM CIM_CODECLASS C
 WHERE (:CODECLASSID = '' OR CODECLASSID LIKE :CODECLASSID + '%')
   AND (:CODECLASSNAME = '' OR CODECLASSNAME LIKE :CODECLASSNAME + '%')
   AND (:ISUSABLE = '' OR ISUSABLE = :ISUSABLE)
   AND SITEID = :SITEID