SELECT C.* 
	,dbo.FN_USERNAME(C.SITEID, C.CREATOR) AS CREATOR2
	,dbo.FN_USERNAME(C.SITEID, C.MODIFIER) AS MODIFIER2
  FROM CIM_INSPDEFINITION C 
 INNER JOIN CIM_INSPDEFINITIONITEMSPEC S 
    ON C.INSPDEFINITIONSYSID = S.INSPDEFINITIONSYSID AND C.SITEID = S.SITEID AND S.ISUSABLE ='Usable'
 WHERE (:INSPITEMID = '' OR S.INSPITEMID = :INSPITEMID)
   AND C.ISUSABLE = 'Usable'
   AND C.SITEID = :SITEID