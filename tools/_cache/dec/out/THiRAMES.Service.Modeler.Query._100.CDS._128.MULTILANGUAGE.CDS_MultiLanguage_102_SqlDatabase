SELECT *, dbo.FN_USERNAME(SITEID, CREATOR) AS CREATOR2, dbo.FN_USERNAME(SITEID, MODIFIER) AS MODIFIER2
  FROM CIM_MULTILANGUAGE
 WHERE (:LANGUAGECODEID = '' OR LANGUAGECODEID LIKE :LANGUAGECODEID )
   AND (:CODETYPE = '' OR CODETYPE = :CODETYPE )
   AND (:LANGUAGE = '' OR LANGUAGE = :LANGUAGE)
   AND (:CODESUBTYPE = '' OR CODESUBTYPE LIKE :CODESUBTYPE )
   AND (:LANGUAGECODEDATA = '' OR LANGUAGECODEDATA LIKE  :LANGUAGECODEDATA )
   AND (:ISUSABLE = '' OR ISUSABLE = :ISUSABLE)
   AND SITEID = :SITEID