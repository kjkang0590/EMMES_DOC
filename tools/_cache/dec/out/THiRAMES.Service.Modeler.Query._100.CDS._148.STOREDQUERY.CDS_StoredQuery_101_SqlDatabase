SELECT STOREDQUERYID
       , STOREDQUERYVERSION
       , STOREDQUERYCLASSID
       , SITEID
       , STOREDQUERYNAME
       , COMMANDTYPE
       , QUERYSTRING
       , COMMENTS
FROM CIM_STOREDQUERY
WHERE (:STOREDQUERYID = '' OR STOREDQUERYID = :STOREDQUERYID)
	  AND (:STOREDQUERYVERSION = '' OR STOREDQUERYVERSION = :STOREDQUERYVERSION)
	  AND (:STOREDQUERYCLASSID = '' OR STOREDQUERYCLASSID = :STOREDQUERYCLASSID)
      AND (:ISUSABLE = '' OR ISUSABLE = :ISUSABLE)
      AND SITEID = :SITEID