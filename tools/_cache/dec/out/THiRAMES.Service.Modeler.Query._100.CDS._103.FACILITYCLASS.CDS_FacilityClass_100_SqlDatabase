SELECT *, dbo.FN_USERNAME(C.SITEID, C.CREATOR) AS CREATOR2, dbo.FN_USERNAME(C.SITEID, C.MODIFIER) AS MODIFIER2
FROM CIM_FACILITYCLASS C
WHERE (:FACILITYCLASSID = '' OR FACILITYCLASSID LIKE :FACILITYCLASSID + '%')
      AND (:FACILITYCLASSNAME = '' OR FACILITYCLASSNAME LIKE :FACILITYCLASSNAME + '%')
      AND (:ISUSABLE = '' OR ISUSABLE = :ISUSABLE)
      AND SITEID = :SITEID