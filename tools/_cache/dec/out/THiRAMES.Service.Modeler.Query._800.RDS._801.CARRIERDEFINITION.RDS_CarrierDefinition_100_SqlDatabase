SELECT C.*, dbo.FN_USERNAME(C.SITEID, C.CREATOR) AS CREATOR2, dbo.FN_USERNAME(C.SITEID, C.MODIFIER) AS MODIFIER2
FROM CIM_CARRIERDEFINITION C
WHERE (:CARRIERDEFINITIONID = '' OR CARRIERDEFINITIONID LIKE :CARRIERDEFINITIONID + '%')
      AND (:CARRIERDEFINITIONNAME = '' OR CARRIERDEFINITIONNAME LIKE :CARRIERDEFINITIONNAME + '%')
      AND (:CARRIERCLASSID = '' OR CARRIERCLASSID LIKE :CARRIERCLASSID + '%')
      AND (:ISUSABLE = '' OR ISUSABLE = :ISUSABLE)
      AND SITEID = :SITEID