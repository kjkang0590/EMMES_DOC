SELECT C.*, dbo.FN_USERNAME(C.SITEID, C.CREATOR) AS CREATOR2, dbo.FN_USERNAME(C.SITEID, C.MODIFIER) AS MODIFIER2
FROM CIM_PROCESSDEFINITION C
WHERE (:PROCESSDEFINITIONID = '' OR PROCESSDEFINITIONID LIKE :PROCESSDEFINITIONID + '%')
      AND (:PROCESSDEFINITIONNAME = '' OR PROCESSDEFINITIONNAME LIKE :PROCESSDEFINITIONNAME + '%')
      AND (:ISUSABLE = '' OR ISUSABLE = :ISUSABLE)
      AND SITEID = :SITEID