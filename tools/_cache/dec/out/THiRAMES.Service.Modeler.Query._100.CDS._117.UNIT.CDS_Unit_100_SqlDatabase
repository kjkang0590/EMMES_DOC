SELECT *, dbo.FN_USERNAME(C.SITEID, C.CREATOR) AS CREATOR2, dbo.FN_USERNAME(C.SITEID, C.MODIFIER) AS MODIFIER2
FROM CIM_UNIT C
WHERE (:UNITID = '' OR UNITID LIKE :UNITID + '%')
  AND (:UNITNAME = '' OR UNITNAME LIKE :UNITNAME + '%')
  AND (:UNITTYPE = '' OR UNITTYPE = :UNITTYPE)
  AND (:ISUSABLE = '' OR ISUSABLE = :ISUSABLE)
  AND SITEID = :SITEID