SELECT C.*, dbo.FN_USERNAME(C.SITEID, C.CREATOR) AS CREATOR2, dbo.FN_USERNAME(C.SITEID, C.MODIFIER) AS MODIFIER2
FROM CIM_MULTILANGUAGE C
WHERE (:LANGUAGECODEID = '' OR LANGUAGECODEID LIKE :LANGUAGECODEID )
      AND (:LANGUAGECODENAME = '' OR LANGUAGECODENAME LIKE :LANGUAGECODENAME )
      AND (:LANGUAGECODEDATA = '' OR LANGUAGECODEDATA LIKE :LANGUAGECODEDATA )
      AND (:ISUSABLE = '' OR ISUSABLE = :ISUSABLE)
      AND SITEID = :SITEID
