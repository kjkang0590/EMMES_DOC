SELECT D.*, dbo.FN_USERNAME(D.SITEID, D.CREATOR) AS CREATOR2, dbo.FN_USERNAME(D.SITEID, D.MODIFIER) AS MODIFIER2
FROM CIM_DEFECT D
WHERE (D.DEFECTCLASSID LIKE :DEFECTCLASSID + '%')
	AND (:DEFECTID  ='' OR D.DEFECTID LIKE :DEFECTID + '%')
	AND (:DEFECTNAME = '' OR D.DEFECTNAME LIKE :DEFECTNAME + '%')
	AND D.SITEID = :SITEID
	AND (:ISUSABLE = '' OR D.ISUSABLE = :ISUSABLE)