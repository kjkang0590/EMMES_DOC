SELECT C.*,  U.USERNAME, S.SITENAME
FROM CIM_LOGINHIST C
INNER JOIN CIM_USER U
	ON C.USERID = U.USERID 
	AND C.SITEID = U.SITEID
INNER JOIN CIM_SITE S
	ON C.SITEID = S.SITEID
WHERE (C.MODIFYTIME >= CONVERT(DATETIME, :FROMDATE) AND C.MODIFYTIME < DATEADD(DAY, 1, CONVERT(DATETIME, :TODATE) ))
	AND (:USERID = '' OR C.USERID LIKE :USERID + '%')
	AND	(:LOGINSYSTEM  = '' OR LOGINSYSTEM LIKE :LOGINSYSTEM + '%')
	AND C.SITEID = :SITEID
ORDER BY LASTEVENTSEQ DESC 