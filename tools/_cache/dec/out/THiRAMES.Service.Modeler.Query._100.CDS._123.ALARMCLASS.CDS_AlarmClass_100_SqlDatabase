SELECT C.*, dbo.FN_USERNAME(C.SITEID, C.CREATOR) AS CREATOR2, dbo.FN_USERNAME(C.SITEID, C.MODIFIER) AS MODIFIER2
FROM CIM_ALARMCLASS C
WHERE (:ALARMCLASSID = '' OR ALARMCLASSID LIKE :ALARMCLASSID + '%')
      AND (:ALARMCLASSNAME = '' OR ALARMCLASSNAME LIKE :ALARMCLASSNAME + '%')
      AND (:ISUSABLE = '' OR ISUSABLE = :ISUSABLE)
      AND SITEID = :SITEID