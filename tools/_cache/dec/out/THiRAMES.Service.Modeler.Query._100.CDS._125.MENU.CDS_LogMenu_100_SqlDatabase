SELECT CL.*, S.SITENAME, M.MENUNAME, U.USERNAME 
FROM CIM_LOGUSERMENU CL
INNER JOIN CIM_SITE S
	ON CL.SITEID = S.SITEID
INNER JOIN CIM_MENU M
	ON CL.MENUID = M.MENUID 
	AND CL.MENUCLASSID = M.MENUCLASSID 
	AND CL.SITEID = M.SITEID
INNER JOIN CIM_USER U
	ON CL.USERID = U.USERID 
	AND CL.SITEID = U.SITEID
WHERE (CL.LOGDATETIME >= CONVERT(DATETIME, :FROMDATE) AND CL.LOGDATETIME < DATEADD(DAY, 1, CONVERT(DATETIME, :TODATE) ))
	AND (:MENUID  = '' OR CL.MENUID LIKE :MENUID + '%')
	AND (:USERID = '' OR CL.USERID LIKE :USERID + '%')
	AND (:LOGINSYSTEM  = '' OR CL.LOGINSYSTEM LIKE :LOGINSYSTEM + '%')
	AND CL.SITEID = :SITEID
ORDER BY LOGDATETIME DESC