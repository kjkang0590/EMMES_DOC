IF :DISPLAYMBOM = 'N'   
	IF :DISPLAYTYPE = 'FORWARD'       
		BEGIN
			;WITH DATA AS (
				  -- 최상위 데이터
				  SELECT BOMID, PRODUCTDEFINITIONID, MATERIALDEFINITIONID, 0 AS LVL, QTY, UNITID, SITEID, CONVERT(NVARCHAR(2000), PRODUCTDEFINITIONID) TREE
				  FROM CIM_BOM 
				  WHERE MATERIALDEFINITIONID = :ITEMID AND SITEID = :SITEID AND ISUSABLE ='Usable'

				  UNION ALL

				  SELECT B.BOMID, B.PRODUCTDEFINITIONID, B.MATERIALDEFINITIONID, A.LVL + 1 AS LVL, B.QTY, B.UNITID, B.SITEID, CONVERT(NVARCHAR(2000), CONVERT(NVARCHAR(2000), A.TREE) + N'.'+ CONVERT(NVARCHAR(2000), B.MATERIALDEFINITIONID ))
				  FROM DATA A INNER JOIN CIM_BOM B  ON A.MATERIALDEFINITIONID = B.PRODUCTDEFINITIONID AND A.SITEID = B.SITEID AND B.ISUSABLE ='Usable'
			), DATA2 AS (
				  SELECT P.PRODUCTDEFINITIONID AS ITEMID, P.PRODUCTDEFINITIONNAME AS ITEMNAME, P.PRODUCTCLASSID AS ITEMCLASSID, P.PRODUCTTYPE AS ITEMTYPE, P.DESCRIPTION, P.SITEID
				  FROM CIM_PRODUCTDEFINITION P 
				  WHERE SITEID = :SITEID AND ISUSABLE ='Usable'
			  UNION ALL
				  SELECT MAT.MATERIALDEFINITIONID , MAT.MATERIALDEFINITIONNAME , MAT.MATERIALCLASSID , MAT.MATERIALTYPE, MAT.DESCRIPTION , MAT.SITEID
				  FROM CIM_MATERIALDEFINITION MAT 
				  WHERE SITEID = :SITEID AND ISUSABLE ='Usable'
			)
			SELECT D.PRODUCTDEFINITIONID, D.MATERIALDEFINITIONID, M.ITEMNAME, M.ITEMCLASSID, M.ITEMTYPE, M.DESCRIPTION,  D.LVL, D.QTY, D.UNITID, D.SITEID, '' PROCESSSEGMENTID, N'' AS PROCESSSEGMENTNAME, D.TREE, D.BOMID
			FROM DATA D LEFT OUTER JOIN DATA2 M ON D.MATERIALDEFINITIONID = M.ITEMID AND D.SITEID = M.SITEID
			WHERE ( :DISPLAYLEVEL1 = 'N' OR D.LVL <= 1 )
		END
	ELSE        
		BEGIN
			;WITH DATA AS (
				  -- 최상위 데이터
				  SELECT BOMID, PRODUCTDEFINITIONID, MATERIALDEFINITIONID, 0 AS LVL, QTY, UNITID, SITEID, CONVERT(NVARCHAR(2000), PRODUCTDEFINITIONID) TREE
				  FROM CIM_BOM 
				  WHERE SITEID = :SITEID AND MATERIALDEFINITIONID = :ITEMID
	   
				  UNION ALL

				  SELECT B.BOMID , B.PRODUCTDEFINITIONID, B.MATERIALDEFINITIONID, A.LVL + 1 AS LVL, B.QTY, B.UNITID, B.SITEID, CONVERT(NVARCHAR(2000), CONVERT(NVARCHAR(2000), A.TREE) + N'.'+ CONVERT(NVARCHAR(2000), B.MATERIALDEFINITIONID ))
				  FROM DATA A INNER JOIN CIM_BOM B  ON A.PRODUCTDEFINITIONID = B.MATERIALDEFINITIONID
				  WHERE B.SITEID = :SITEID AND B.PRODUCTDEFINITIONID <> '-'
			), DATA2 AS (
				  SELECT P.PRODUCTDEFINITIONID AS ITEMID, P.PRODUCTDEFINITIONNAME AS ITEMNAME, P.PRODUCTCLASSID AS ITEMCLASSID, P.PRODUCTTYPE AS ITEMTYPE, P.DESCRIPTION, P.SITEID
				  FROM CIM_PRODUCTDEFINITION P 
				  WHERE SITEID = :SITEID AND ISUSABLE ='Usable'

				  UNION ALL
	          
				  SELECT MAT.MATERIALDEFINITIONID , MAT.MATERIALDEFINITIONNAME , MAT.MATERIALCLASSID , MAT.MATERIALTYPE, MAT.DESCRIPTION , MAT.SITEID
				  FROM CIM_MATERIALDEFINITION MAT 
				  WHERE SITEID = :SITEID AND ISUSABLE ='Usable'
			)
			SELECT D.PRODUCTDEFINITIONID, D.MATERIALDEFINITIONID, M1.ITEMNAME, M1.ITEMCLASSID, M1.ITEMTYPE, M1.DESCRIPTION,  D.LVL, D.QTY, D.UNITID, D.SITEID, '' PROCESSSEGMENTID, N'' AS PROCESSSEGMENTNAME, D.TREE, D.BOMID
			FROM DATA D LEFT OUTER JOIN DATA2 M1 ON D.MATERIALDEFINITIONID = M1.ITEMID AND D.SITEID = M1.SITEID
			WHERE ( :DISPLAYLEVEL1 = 'N' OR D.LVL <= 1 )
		END
IF :DISPLAYMBOM = 'Y'   
	IF :DISPLAYTYPE = 'FORWARD'       
		BEGIN
			;WITH DATA AS (
				  -- 최상위 데이터
				  SELECT BOMID, PRODUCTDEFINITIONID, MATERIALDEFINITIONID, 0 AS LVL, QTY, UNITID, SITEID, DESCRIPTION, CONVERT(NVARCHAR(2000), PRODUCTDEFINITIONID) TREE
				  FROM CIM_BOM 
				  WHERE MATERIALDEFINITIONID = :ITEMID AND SITEID = :SITEID AND ISUSABLE ='Usable'
	   
				  UNION ALL

				  SELECT B.BOMID , B.PRODUCTDEFINITIONID, B.MATERIALDEFINITIONID, A.LVL + 1 AS LVL, B.QTY, B.UNITID, B.SITEID, B.DESCRIPTION , CONVERT(NVARCHAR(2000), CONVERT(NVARCHAR(2000), A.TREE) + N'.'+ CONVERT(NVARCHAR(2000), B.MATERIALDEFINITIONID )) 
				  FROM DATA A INNER JOIN CIM_BOM B  ON A.MATERIALDEFINITIONID = B.PRODUCTDEFINITIONID AND A.SITEID = B.SITEID AND B.ISUSABLE ='Usable'
			), DATA2 AS (
				  SELECT P.PRODUCTDEFINITIONID AS ITEMID, P.PRODUCTDEFINITIONNAME AS ITEMNAME, P.PRODUCTCLASSID AS ITEMCLASSID, P.PRODUCTTYPE AS ITEMTYPE, P.DESCRIPTION, P.SITEID
				  FROM CIM_PRODUCTDEFINITION P 
				  WHERE SITEID = :SITEID AND ISUSABLE ='Usable'

				  UNION ALL

				  SELECT MAT.MATERIALDEFINITIONID , MAT.MATERIALDEFINITIONNAME , MAT.MATERIALCLASSID , MAT.MATERIALTYPE, MAT.DESCRIPTION , MAT.SITEID
				  FROM CIM_MATERIALDEFINITION MAT 
				  WHERE SITEID = :SITEID AND ISUSABLE ='Usable'
			), DATA3 AS (
				  SELECT PR.PRODUCTRULESYSID , PR.PROCESSSEGMENTID , PS.PROCESSSEGMENTNAME, PR.SITEID 
				  FROM CIM_PROCESSSEGMENT PS  LEFT OUTER JOIN CIM_PRODUCTRULE PR  ON PR.PROCESSSEGMENTID = PS.PROCESSSEGMENTID AND PR.SITEID = PS.SITEID AND PR.ISUSABLE ='Usable'
				  WHERE PS.SITEID = :SITEID AND PS.ISUSABLE = 'Usable'
			)
			SELECT T.PRODUCTDEFINITIONID, T.MATERIALDEFINITIONID, T.ITEMNAME, T.ITEMCLASSID, T.ITEMTYPE, T.LVL, T.QTY, T.UNITID, T.SITEID, T.DESCRIPTION, T.PROCESSSEGMENTID, T.PROCESSSEGMENTNAME, T.TREE, T.BOMID
			FROM (
				  SELECT D.PRODUCTDEFINITIONID, D.MATERIALDEFINITIONID, M.ITEMNAME, M.ITEMCLASSID, M.ITEMTYPE,  D.LVL, D.QTY, D.UNITID, D.SITEID, D.DESCRIPTION, '' PROCESSSEGMENTID, N'' AS PROCESSSEGMENTNAME, D.TREE, D.BOMID
				  FROM DATA D LEFT OUTER JOIN DATA2 M ON D.MATERIALDEFINITIONID = M.ITEMID AND D.SITEID = M.SITEID

				  UNION ALL 

				  SELECT D.MATERIALDEFINITIONID, D2.MATERIALDEFINITIONID, M.ITEMNAME, M.ITEMCLASSID, M.ITEMTYPE, D.LVL+1, D2.MBOMQTY, D2.MBOMUNIT, D2.SITEID, D2.DESCRIPTION, D3.PROCESSSEGMENTID, D3.PROCESSSEGMENTNAME, D.TREE, '' AS BOMID
				  FROM DATA D INNER JOIN CIM_MBOM D2  ON D.BOMID = D2.BOMID AND D.SITEID = D2.SITEID
							  LEFT OUTER JOIN DATA3 D3 ON D2.PRODUCTRULESYSID = D3.PRODUCTRULESYSID AND D2.SITEID = D3.SITEID 
							  LEFT OUTER JOIN DATA2 M ON D2.MATERIALDEFINITIONID = M.ITEMID AND D2.SITEID = M.SITEID
			) T
			WHERE ( :DISPLAYLEVEL1 = 'N' OR T.LVL <= 1 )	 
			ORDER BY T.LVL, T.TREE
		END
	ELSE        
		BEGIN
			;WITH DATA AS (
				  -- 최상위 데이터
				  SELECT BOMID, PRODUCTDEFINITIONID, MATERIALDEFINITIONID, 0 AS LVL, QTY, UNITID, SITEID, DESCRIPTION, CONVERT(NVARCHAR(2000), PRODUCTDEFINITIONID) TREE
				  FROM CIM_BOM 
				  WHERE SITEID = :SITEID AND MATERIALDEFINITIONID = :ITEMID

				  UNION ALL

				  SELECT B.BOMID , B.PRODUCTDEFINITIONID, B.MATERIALDEFINITIONID, A.LVL + 1 AS LVL, B.QTY, B.UNITID, B.SITEID, B.DESCRIPTION, CONVERT(NVARCHAR(2000), CONVERT(NVARCHAR(2000), A.TREE) + N'.'+ CONVERT(NVARCHAR(2000), B.MATERIALDEFINITIONID ))
				  FROM DATA A INNER JOIN CIM_BOM B  ON A.PRODUCTDEFINITIONID = B.MATERIALDEFINITIONID
				  WHERE B.SITEID = :SITEID AND B.PRODUCTDEFINITIONID <> '-'
			), DATA2 AS (
				  SELECT P.PRODUCTDEFINITIONID AS ITEMID, P.PRODUCTDEFINITIONNAME AS ITEMNAME, P.PRODUCTCLASSID AS ITEMCLASSID, P.PRODUCTTYPE AS ITEMTYPE, P.DESCRIPTION, P.SITEID
				  FROM CIM_PRODUCTDEFINITION P 
				  WHERE SITEID = :SITEID AND ISUSABLE ='Usable'

				  UNION ALL

				  SELECT MAT.MATERIALDEFINITIONID , MAT.MATERIALDEFINITIONNAME , MAT.MATERIALCLASSID , MAT.MATERIALTYPE, MAT.DESCRIPTION , MAT.SITEID
				  FROM CIM_MATERIALDEFINITION MAT 
				  WHERE SITEID = :SITEID AND ISUSABLE ='Usable'
			), DATA3 AS (
				  SELECT PR.PRODUCTRULESYSID , PR.PROCESSSEGMENTID , PS.PROCESSSEGMENTNAME, PR.SITEID 
				  FROM CIM_PROCESSSEGMENT PS  LEFT OUTER JOIN CIM_PRODUCTRULE PR  ON PR.PROCESSSEGMENTID = PS.PROCESSSEGMENTID AND PR.SITEID = PS.SITEID AND PR.ISUSABLE ='Usable'
				  WHERE PS.SITEID = :SITEID AND PS.ISUSABLE = 'Usable'
			)
			SELECT T.PRODUCTDEFINITIONID, T.MATERIALDEFINITIONID, T.ITEMNAME, T.ITEMCLASSID, T.ITEMTYPE, T.LVL, T.QTY, T.UNITID, T.SITEID, T.DESCRIPTION, T.PROCESSSEGMENTID, T.PROCESSSEGMENTNAME, T.TREE, T.BOMID
			FROM (
				  SELECT D.PRODUCTDEFINITIONID, D.MATERIALDEFINITIONID, M.ITEMNAME, M.ITEMCLASSID, M.ITEMTYPE,  D.LVL, D.QTY, D.UNITID, D.SITEID, D.DESCRIPTION, '' PROCESSSEGMENTID, N'' AS PROCESSSEGMENTNAME, D.TREE, D.BOMID
				  FROM DATA D LEFT OUTER JOIN DATA2 M ON D.MATERIALDEFINITIONID = M.ITEMID AND D.SITEID = M.SITEID

				  UNION ALL 

				  SELECT D.MATERIALDEFINITIONID, D2.MATERIALDEFINITIONID, M.ITEMNAME, M.ITEMCLASSID, M.ITEMTYPE, D.LVL+1, D2.MBOMQTY, D2.MBOMUNIT, D2.SITEID, D2.DESCRIPTION, D3.PROCESSSEGMENTID, D3.PROCESSSEGMENTNAME, D.TREE, '' AS BOMID
				  FROM DATA D INNER JOIN CIM_MBOM D2  ON D.BOMID = D2.BOMID AND D.SITEID = D2.SITEID
							  LEFT OUTER JOIN DATA3 D3 ON D2.PRODUCTRULESYSID = D3.PRODUCTRULESYSID AND D2.SITEID = D3.SITEID 
							  LEFT OUTER JOIN DATA2 M ON D2.MATERIALDEFINITIONID = M.ITEMID AND D2.SITEID = M.SITEID
			) T
			WHERE ( :DISPLAYLEVEL1 = 'N' OR T.LVL <= 1 )	 
			ORDER BY T.LVL, T.TREE
		END