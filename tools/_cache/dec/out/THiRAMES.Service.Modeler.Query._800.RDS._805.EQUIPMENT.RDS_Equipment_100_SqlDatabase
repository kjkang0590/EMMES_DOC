SELECT C.*, dbo.FN_USERNAME(C.SITEID, C.CREATOR) AS CREATOR2, dbo.FN_USERNAME(C.SITEID, C.MODIFIER) AS MODIFIER2
FROM CIM_EQUIPMENT C
WHERE (:EQUIPMENTID = '' OR EQUIPMENTID LIKE :EQUIPMENTID + '%')
      AND (:EQUIPMENTNAME = '' OR EQUIPMENTNAME LIKE :EQUIPMENTNAME + '%')
      AND (:EQUIPMENTCLASSID = '' OR EQUIPMENTCLASSID LIKE :EQUIPMENTCLASSID + '%')
      AND (:ISUSABLE = '' OR ISUSABLE = :ISUSABLE)
      AND SITEID = :SITEID