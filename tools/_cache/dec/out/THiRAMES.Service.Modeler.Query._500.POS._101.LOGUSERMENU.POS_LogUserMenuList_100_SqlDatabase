SELECT TOP 10 A.MENUID, ISNULL(CML.LANGUAGECODEDATA, CM.MENUNAME) AS MENUNAME, A.CNT
  FROM (
		SELECT COUNT(MENUID) AS CNT, MENUID, SITEID
		  FROM CIM_LOGUSERMENU 
		 WHERE LOGDATETIME >= DATEADD(DAY, CONVERT(INT, :DAYCOUNT), GETDATE()) 
		   AND ISUSABLE = 'Usable' 
		   AND SITEID = :SITEID 
		   AND USERID = :USERID
		   AND (:LOGINSYSTEM = '' OR LOGINSYSTEM = :LOGINSYSTEM) 
		 GROUP BY MENUID,SITEID
		) A
	LEFT OUTER JOIN CIM_MENU CM ON A.SITEID = CM.SITEID AND A.MENUID = CM.MENUID
	LEFT OUTER JOIN CIM_MULTILANGUAGE CML ON A.SITEID = CML.SITEID AND A.MENUID = CML.LANGUAGECODEID AND CML.LANGUAGE = :LANGUAGE
 ORDER BY CNT DESC