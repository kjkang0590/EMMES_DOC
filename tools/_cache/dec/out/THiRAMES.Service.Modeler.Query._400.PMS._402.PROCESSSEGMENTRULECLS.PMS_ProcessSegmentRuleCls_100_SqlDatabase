SELECT C.*, dbo.FN_USERNAME(C.SITEID, C.CREATOR) AS CREATOR2, dbo.FN_USERNAME(C.SITEID, C.MODIFIER) AS MODIFIER2
FROM CIM_PROCESSSEGMENTRULECLS C
WHERE (:PROCESSSEGMENTRULECLSID = '' OR PROCESSSEGMENTRULECLSID LIKE :PROCESSSEGMENTRULECLSID + '%')
      AND (:PROCESSSEGMENTRULECLSNAME = '' OR PROCESSSEGMENTRULECLSNAME LIKE :PROCESSSEGMENTRULECLSNAME + '%')
      AND (:ISUSABLE = '' OR ISUSABLE = :ISUSABLE)
      AND SITEID = :SITEID