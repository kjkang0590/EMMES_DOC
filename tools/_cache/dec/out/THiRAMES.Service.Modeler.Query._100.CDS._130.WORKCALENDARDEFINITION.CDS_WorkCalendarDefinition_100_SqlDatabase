SELECT C.*, dbo.FN_USERNAME(C.SITEID, C.CREATOR) AS CREATOR2, dbo.FN_USERNAME(C.SITEID, C.MODIFIER) AS MODIFIER2
  FROM CIM_WORKCALENDARDEFINITION C
 WHERE (:WORKCALENDARDEFINITIONID = '' OR WORKCALENDARDEFINITIONID LIKE :WORKCALENDARDEFINITIONID + '%')
   AND (:WORKCALENDARDEFINITIONNAME = '' OR WORKCALENDARDEFINITIONNAME LIKE :WORKCALENDARDEFINITIONNAME + '%')
   AND (:ISUSABLE = '' OR ISUSABLE = :ISUSABLE)
   AND SITEID = :SITEID
