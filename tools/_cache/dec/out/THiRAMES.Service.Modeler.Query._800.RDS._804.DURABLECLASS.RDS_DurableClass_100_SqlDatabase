SELECT C.*, dbo.FN_USERNAME(C.SITEID, C.CREATOR) AS CREATOR2, dbo.FN_USERNAME(C.SITEID, C.MODIFIER) AS MODIFIER2
FROM CIM_DURABLECLASS C
WHERE (:DURABLECLASSID = '' OR DURABLECLASSID LIKE :DURABLECLASSID + '%')
      AND (:DURABLECLASSNAME = '' OR DURABLECLASSNAME LIKE :DURABLECLASSNAME + '%')
      AND (:ISUSABLE = '' OR ISUSABLE = :ISUSABLE)
      AND SITEID = :SITEID