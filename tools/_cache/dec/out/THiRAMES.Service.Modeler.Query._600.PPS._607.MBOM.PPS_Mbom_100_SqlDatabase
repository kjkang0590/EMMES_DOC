SELECT M.*, dbo.FN_USERNAME(M.SITEID, M.CREATOR) AS CREATOR2, dbo.FN_USERNAME(M.SITEID, N.MODIFIER) AS MODIFIER2
FROM CIM_MBOM M INNER JOIN CIM_PRODUCTRULE PR ON M.PRODUCTRULESYSID = PR.PRODUCTRULESYSID
WHERE (:PRODUCTDEFINITIONID = '' OR PR.PRODUCTDEFINITIONID LIKE :PRODUCTDEFINITIONID + '%')
      AND (:ISUSABLE = '' OR M.ISUSABLE = :ISUSABLE)
      AND M.SITEID = :SITEID