SELECT C.*, dbo.FN_USERNAME(C.SITEID, C.CREATOR) AS CREATOR2, dbo.FN_USERNAME(C.SITEID, C.MODIFIER) AS MODIFIER2
FROM CIM_CARRIERCLASS C
WHERE (:CARRIERCLASSID = '' OR CARRIERCLASSID LIKE :CARRIERCLASSID + '%')
      AND (:CARRIERCLASSNAME = '' OR CARRIERCLASSNAME LIKE :CARRIERCLASSNAME + '%')
      AND (:ISUSABLE = '' OR ISUSABLE = :ISUSABLE)
      AND SITEID = :SITEID