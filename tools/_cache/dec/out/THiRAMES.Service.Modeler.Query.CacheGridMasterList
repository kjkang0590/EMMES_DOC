
SELECT 
   GM.COLUMNID
  ,GM.GRIDID
  ,GM.MENUID
  ,GM.SITEID
  ,GM.PARENTCOLUMNID
  ,GM.GRIDTYPE
  ,GM.SEQUENCE
  ,GM.BANDSEQ
  ,GM.GROUPSEQ
  ,GM.SORTSEQ
  ,GM.BANDROW
  ,GM.BANDROWSPAN
  ,GM.BANDCOLSPAN
  ,GM.COLUMNNAME
  ,GM.FIELD
  ,GM.HALIGN
  ,GM.FIXEDTYPE
  ,GM.WIDTH
  ,GM.DATATYPE
  ,GM.COLUMNTYPE
  ,GM.DISPLAYMEMBER
  ,GM.VALUEMEMBER
  ,GM.MASK
  ,GM.FORMAT
  ,GM.SORTTYPE
  ,GM.SUBSUMTYPE
  ,GM.TOTALSUMTYPE
  ,GM.SUBSUMFORMAT
  ,GM.TOTALSUMFORMAT
  ,GM.EXPR
  ,GM.ISBAND
  ,GM.ISHIDDEN
  ,GM.ISMANDATORY
  ,GM.ISEDIT
  ,GM.ISSORT
  ,GM.ISGROUP
  ,GM.ISSUBSUM
  ,GM.ISTOTALSUM
  ,GM.ISUSABLE
  FROM CIM_MENU M
 INNER JOIN CIM_GRIDMASTER GM
 	ON GM.MENUID = M.MENUID AND GM.SITEID = M.SITEID AND GM.ISUSABLE ='Usable'
 INNER JOIN CIM_USERCLASSMENUREL UM
 	ON M.MENUID = UM.MENUID AND M.MENUCLASSID = UM.MENUCLASSID AND M.SITEID = UM.SITEID AND UM.ISUSABLE ='Usable'
 INNER JOIN CIM_USERCLASSREL UC
 	ON UM.USERCLASSID = UC.USERCLASSID AND UM.SITEID = UC.SITEID AND UC.ISUSABLE ='Usable'
   AND UC.USERID = :USERID
 WHERE M.MENUCLASSID = :MENUCLASSID
   AND M.SITEID = :SITEID
   AND M.ISUSABLE ='Usable'
