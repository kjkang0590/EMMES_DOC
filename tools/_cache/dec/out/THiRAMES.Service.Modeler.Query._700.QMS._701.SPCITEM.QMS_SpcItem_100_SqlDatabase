SELECT C.*, dbo.FN_USERNAME(C.SITEID, C.CREATOR) AS CREATOR2, dbo.FN_USERNAME(C.SITEID, C.MODIFIER) AS MODIFIER2
FROM CIM_SPCITEM C
WHERE (:SPCITEMID = '' OR SPCITEMID LIKE :SPCITEMID + '%')
      AND (:SPCITEMNAME = '' OR SPCITEMNAME LIKE :SPCITEMNAME + '%')
      AND (:PRODUCTDEFINITIONID = '' OR PRODUCTDEFINITIONID LIKE :PRODUCTDEFINITIONID + '%')
      AND (:EQUIPMENTID = '' OR EQUIPMENTID LIKE :EQUIPMENTID + '%')
      AND (:ISUSABLE = '' OR ISUSABLE = :ISUSABLE)
      AND SITEID = :SITEID
