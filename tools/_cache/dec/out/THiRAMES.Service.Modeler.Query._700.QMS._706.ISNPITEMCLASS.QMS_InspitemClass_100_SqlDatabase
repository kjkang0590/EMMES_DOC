SELECT IIC.*, dbo.FN_USERNAME(IIC.SITEID, IIC.CREATOR) AS CREATOR2, dbo.FN_USERNAME(IIC.SITEID, IIC.MODIFIER) AS MODIFIER2
FROM CIM_INSPITEMCLASS IIC
WHERE (:INSPITEMCLASSID IS NULL OR IIC.INSPITEMCLASSID LIKE :INSPITEMCLASSID + '%')
   AND (:INSPITEMCLASSNAME IS NULL OR IIC.INSPITEMCLASSNAME LIKE :INSPITEMCLASSNAME + '%')
   AND (:ISUSABLE IS NULL OR ISUSABLE = :ISUSABLE)
   AND SITEID = :SITEID