SELECT
        UFM.USERID,
        UFM.FAVORITEMENUID ,
        UFM.FAVORITEMENUCLASSID ,
        UFM.SITEID ,
        UFM.FAVORITEMENUTYPE  ,
        UFM.PARENTID  ,
        UFM.MENUID ,
        UFM.MENUCLASSID  ,
        UFM."SEQUENCE",
        M.MENUNAME,
        M.CONTROLTYPE ,
        M.VIEWID 
  FROM CIM_USERFAVORITEMENU UFM
 INNER JOIN CIM_MENU M
        ON UFM.MENUID = M.MENUID AND UFM.MENUCLASSID = M.MENUCLASSID AND UFM.SITEID = M.SITEID AND M.ISUSABLE ='Usable'
 WHERE UFM.USERID=:USERID
   AND UFM.SITEID=:SITEID
   AND UFM.ISUSABLE ='Usable'
