SELECT C.*,
	   COP.COPERATORNAME,
	   MC.MATERIALCLASSNAME,
	   M.MATERIALDEFINITIONNAME,
	   ST.STATENAME,
	   CD1.CODENAME AS INSPTYPENAME,
	   CD2.CODENAME AS INSPMETHODNAME,
	   CD3.CODENAME AS INSPSPECNAME,
	   dbo.FN_USERNAME(C.SITEID, C.CREATOR) AS CREATOR2, 
	   dbo.FN_USERNAME(C.SITEID, C.MODIFIER) AS MODIFIER2
FROM CIM_INSPDEFINITION C
LEFT OUTER JOIN (
  			SELECT VD.VENDORID AS CID, VD.VENDORNAME AS COPERATORNAME, VD.SITEID FROM CIM_VENDOR VD
  			UNION ALL
  			SELECT CT.CUSTOMERID AS CID, CT.CUSTOMERNAME AS COPERATORNAME, CT.SITEID FROM CIM_CUSTOMER CT
  		   ) COP 
	ON C.COPERATOR = COP.CID
	AND C.SITEID = COP.SITEID
LEFT OUTER JOIN CIM_MATERIALDEFINITION M 
	ON C.ITEMID = M.MATERIALDEFINITIONID
	AND C.SITEID = M.SITEID 
LEFT OUTER JOIN CIM_MATERIALCLASS MC 
	ON M.MATERIALCLASSID = MC.MATERIALCLASSID
	AND C.SITEID = M.SITEID 
INNER JOIN CIM_STATE ST 
	ON C.STATE = ST.STATEID
	AND ST.STATEMODELID = 'InspDefinitionState'
	AND C.SITEID = ST.SITEID
INNER JOIN CIM_CODE CD1
	ON C.INSPTYPE = CD1.CODEID
	AND CD1.CODECLASSID = 'INSPTYPE'
	AND C.SITEID = CD1.SITEID 
INNER JOIN CIM_CODE CD2
	ON C.INSPMETHOD = CD2.CODEID
	AND CD2.CODECLASSID = 'INSPMETHOD'
	AND C.SITEID = CD2.SITEID 
LEFT OUTER JOIN CIM_CODE CD3
	ON C.INSPSPEC = CD3.CODEID
	AND CD3.CODECLASSID = 'INSPSPEC'
	AND C.SITEID = CD3.SITEID 
WHERE (:COPERATOR = '' OR C.COPERATOR = :COPERATOR)
   AND (:INSPTYPE = '' OR C.INSPTYPE = :INSPTYPE)
   AND (:ITEMID = '' OR C.ITEMID = :ITEMID)
   AND (:REV = '' OR C.REV = CAST(:REV AS int))
   AND (:INSPDEFINITIONNAME = '' OR INSPDEFINITIONNAME LIKE :INSPDEFINITIONNAME + '%')
   AND (:INSPSPEC = '' OR C.INSPSPEC = :INSPSPEC)
   AND (:INSPMETHOD = '' OR C.INSPMETHOD = :INSPMETHOD)
   AND (:STATE = '' OR C.STATE = :STATE)
   AND (:ISUSABLE = '' OR C.ISUSABLE = :ISUSABLE)
   AND C.SITEID = :SITEID
ORDER BY C.INSPDEFINITIONSYSID, C.REV