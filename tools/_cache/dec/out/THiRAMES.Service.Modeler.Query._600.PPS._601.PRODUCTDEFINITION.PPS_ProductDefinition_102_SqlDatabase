SELECT PRODUCTCLASSID AS ITEMCLASSID,
	   PRODUCTDEFINITIONID AS ITEMDEFINITIONID,
	   PRODUCTDEFINITIONNAME AS ITEMDEFINITIONNAME,
	   PRODUCTTYPE AS ITEMTYPE,
	   DESCRIPTION,
	   CREATOR,
	   dbo.FN_USERNAME(SITEID, CREATOR) AS CREATOR2,
	   CREATETIME,
	   MODIFIER,
	   dbo.FN_USERNAME(SITEID, MODIFIER) AS MODIFIER2,
	   MODIFYTIME
  FROM CIM_PRODUCTDEFINITION   
 WHERE (:PRODUCTDEFINITIONID = '' OR PRODUCTDEFINITIONID LIKE :PRODUCTDEFINITIONID + '%')
   AND (:PRODUCTDEFINITIONNAME = '' OR PRODUCTDEFINITIONNAME LIKE :PRODUCTDEFINITIONNAME + '%')
   AND (:PRODUCTCLASSID = '' OR PRODUCTCLASSID LIKE :PRODUCTCLASSID + '%')
   AND ISUSABLE = 'Usable'
   AND SITEID = :SITEID
UNION ALL
SELECT MATERIALCLASSID AS ITEMCLASSID,
	   MATERIALDEFINITIONID AS ITEMDEFINITIONID,
	   MATERIALDEFINITIONNAME AS ITEMDEFINITIONNAME,
	   MATERIALTYPE AS ITEMTYPE,
	   DESCRIPTION,
	   CREATOR,
	   dbo.FN_USERNAME(SITEID, CREATOR) AS CREATOR2,
	   CREATETIME,
	   MODIFIER,
	   dbo.FN_USERNAME(SITEID, MODIFIER) AS MODIFIER2,
	   MODIFYTIME   
  FROM CIM_MATERIALDEFINITION
WHERE (:PRODUCTDEFINITIONID = '' OR MATERIALDEFINITIONID LIKE :PRODUCTDEFINITIONID + '%')
  AND (:PRODUCTDEFINITIONNAME = '' OR MATERIALDEFINITIONNAME LIKE :PRODUCTDEFINITIONNAME + '%')
  AND (:PRODUCTCLASSID = '' OR MATERIALCLASSID LIKE :PRODUCTCLASSID + '%')
  AND ISUSABLE = 'Usable'
  AND SITEID = :SITEID