SELECT C.*, dbo.FN_USERNAME(C.SITEID, C.CREATOR) AS CREATOR2, dbo.FN_USERNAME(C.SITEID, C.MODIFIER) AS MODIFIER2
FROM CIM_DURABLEDEFINITION C
WHERE (:DURABLEDEFINITIONID = '' OR DURABLEDEFINITIONID LIKE :DURABLEDEFINITIONID + '%')
      AND (:DURABLEDEFINITIONNAME = '' OR DURABLEDEFINITIONNAME LIKE :DURABLEDEFINITIONNAME + '%')
      AND (:DURABLECLASSID = '' OR DURABLECLASSID LIKE :DURABLECLASSID + '%')
      AND (:ISUSABLE = '' OR ISUSABLE = :ISUSABLE)
      AND SITEID = :SITEID