SELECT C.*, dbo.FN_USERNAME(C.SITEID, C.CREATOR) AS CREATOR2, dbo.FN_USERNAME(C.SITEID, C.MODIFIER) AS MODIFIER2
FROM CIM_MATERIALCLASS C
WHERE (:MATERIALCLASSID = '' OR MATERIALCLASSID LIKE :MATERIALCLASSID + '%')
      AND (:MATERIALCLASSNAME = '' OR MATERIALCLASSNAME LIKE :MATERIALCLASSNAME + '%')
      AND (:ISUSABLE = '' OR ISUSABLE = :ISUSABLE)
      AND SITEID = :SITEID