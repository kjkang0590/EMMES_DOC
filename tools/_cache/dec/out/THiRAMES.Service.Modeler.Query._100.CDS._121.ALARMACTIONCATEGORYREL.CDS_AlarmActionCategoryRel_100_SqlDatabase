SELECT C.*, dbo.FN_USERNAME(C.SITEID, C.CREATOR) AS CREATOR2, dbo.FN_USERNAME(C.SITEID, C.MODIFIER) AS MODIFIER2
  FROM CIM_ALARMACTIONCATEGORYREL C
 WHERE (:ALARMACTIONCATEGORYID = '' OR ALARMACTIONCATEGORYID LIKE :ALARMACTIONCATEGORYID + '%')
  AND (:ALARMACTIONID = '' OR ALARMACTIONID LIKE :ALARMACTIONID + '%')
  AND (:ISUSABLE = '' OR ISUSABLE = :ISUSABLE)
  AND SITEID = :SITEID