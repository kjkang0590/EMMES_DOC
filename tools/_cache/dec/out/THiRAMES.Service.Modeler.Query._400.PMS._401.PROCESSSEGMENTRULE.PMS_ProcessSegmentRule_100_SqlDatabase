SELECT C.*, dbo.FN_USERNAME(C.SITEID, C.CREATOR) AS CREATOR2, dbo.FN_USERNAME(C.SITEID, C.MODIFIER) AS MODIFIER2
FROM CIM_PROCESSSEGMENTRULE C
WHERE (:PROCESSSEGMENTRULEID = '' OR PROCESSSEGMENTRULEID LIKE :PROCESSSEGMENTRULEID + '%')
      AND (:PROCESSSEGMENTRULENAME = '' OR PROCESSSEGMENTRULENAME LIKE :PROCESSSEGMENTRULENAME + '%')
      AND (:ISUSABLE = '' OR ISUSABLE = :ISUSABLE)
      AND SITEID = :SITEID