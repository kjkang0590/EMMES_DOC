SELECT *, dbo.FN_USERNAME(C.SITEID, C.CREATOR) AS CREATOR2, dbo.FN_USERNAME(C.SITEID, C.MODIFIER) AS MODIFIER2
  FROM CIM_ALARMACTION C
 WHERE (:ALARMACTIONID = '' OR ALARMACTIONID LIKE :ALARMACTIONID + '%')
   AND (:ALARMACTIONNAME = '' OR ALARMACTIONNAME LIKE :ALARMACTIONNAME + '%')
   AND (:ISUSABLE = '' OR ISUSABLE = :ISUSABLE)
   AND SITEID = :SITEID