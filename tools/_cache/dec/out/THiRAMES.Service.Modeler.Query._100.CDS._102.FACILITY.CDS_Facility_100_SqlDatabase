SELECT *, dbo.FN_USERNAME(C.SITEID, C.CREATOR) AS CREATOR2, dbo.FN_USERNAME(C.SITEID, C.MODIFIER) AS MODIFIER2
FROM CIM_FACILITY C
WHERE FACILITYID LIKE :FACILITYID + '%'
      AND (:FACILITYNAME = '' OR FACILITYNAME LIKE :FACILITYNAME + '%')
      AND (:FACILITYCLASSID = '' OR FACILITYCLASSID LIKE :FACILITYCLASSID + '%')
      AND (:FACILITYTYPE = '' OR FACILITYTYPE LIKE :FACILITYTYPE + '%')
      AND (:ISUSABLE = '' OR ISUSABLE = :ISUSABLE)
      AND SITEID = :SITEID