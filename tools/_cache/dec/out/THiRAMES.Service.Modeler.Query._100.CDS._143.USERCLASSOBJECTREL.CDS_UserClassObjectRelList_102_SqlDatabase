   SELECT DISTINCT A.OBJECTID ,A.MENUID ,A.MENUCLASSID ,A.SITEID ,A.OBJECTNAME ,A.OBJECTTYPE,A.ISENABLE ,A.ISVISIBLE  
  FROM CIM_USERCLASSOBJECTREL A
  INNER JOIN CIM_USERCLASSREL B ON A.USERCLASSID  = B.USERCLASSID  
  AND A.SITEID = B.SITEID 
  AND B.ISUSABLE = 'Usable'
 WHERE MENUID=:MENUID
   AND MENUCLASSID=:MENUCLASSID
   AND B.USERID = :USERID
   AND A.SITEID=:SITEID