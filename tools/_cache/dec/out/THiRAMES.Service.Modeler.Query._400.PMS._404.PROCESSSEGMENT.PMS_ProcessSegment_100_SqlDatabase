SELECT C.*, dbo.FN_USERNAME(C.SITEID, C.CREATOR) AS CREATOR2, dbo.FN_USERNAME(C.SITEID, C.MODIFIER) AS MODIFIER2
FROM CIM_PROCESSSEGMENT C
WHERE (:PROCESSSEGMENTID = '' OR PROCESSSEGMENTID LIKE :PROCESSSEGMENTID + '%')
      AND (:PROCESSSEGMENTNAME = '' OR PROCESSSEGMENTNAME LIKE :PROCESSSEGMENTNAME + '%')
      AND (:ISUSABLE = '' OR ISUSABLE = :ISUSABLE)
      AND SITEID = :SITEID