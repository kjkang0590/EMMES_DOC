SELECT C.*, dbo.FN_USERNAME(C.SITEID, C.CREATOR) AS CREATOR2, dbo.FN_USERNAME(C.SITEID, C.MODIFIER) AS MODIFIER2
  FROM CIM_ALARMDEFINITION C
 WHERE (:ALARMDEFINITIONID = '' OR ALARMDEFINITIONID LIKE :ALARMDEFINITIONID + '%')
   AND (:ALARMDEFINITIONNAME = '' OR ALARMDEFINITIONNAME LIKE :ALARMDEFINITIONNAME + '%')
   AND (:ALARMCLASSID = '' OR ALARMCLASSID LIKE :ALARMCLASSID + '%')
   AND (:ISUSABLE = '' OR ISUSABLE = :ISUSABLE)
   AND SITEID = :SITEID