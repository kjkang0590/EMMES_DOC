SELECT *, dbo.FN_USERNAME(C.SITEID, C.CREATOR) AS CREATOR2, dbo.FN_USERNAME(C.SITEID, C.MODIFIER) AS MODIFIER2
FROM CIM_CODE C
WHERE (:CODEID = '' OR CODEID LIKE :CODEID + '%')
  AND (:CODENAME = '' OR CODENAME LIKE :CODENAME + '%')
  AND (:CODECLASSID = '' OR CODECLASSID LIKE :CODECLASSID + '%')
  AND (:ISUSABLE = '' OR ISUSABLE = :ISUSABLE)
  AND SITEID = :SITEID