SELECT C.*,
	   D.COPERATOR,
	   D.ITEMID,
	   D.INSPTYPE ,
	   D.REV ,
	   COP.COPERATORNAME,
	   M.MATERIALDEFINITIONNAME,
	   CD1.CODENAME AS INSPTYPENAME,
	   CD2.CODENAME AS DATATYPENAME,
	   CD3.CODENAME AS CALCULATETYPENAME,
	   CD4.CODENAME AS INSPSPECNAME,
	   II.INSPITEMNAME,
	   dbo.FN_USERNAME(C.SITEID, C.CREATOR) AS CREATOR2, 
	   dbo.FN_USERNAME(C.SITEID, C.MODIFIER) AS MODIFIER2
FROM CIM_INSPDEFINITIONITEMSPEC C
INNER JOIN CIM_INSPDEFINITION D
  	ON C.INSPDEFINITIONSYSID = D.INSPDEFINITIONSYSID 
  	AND C.SITEID = D.SITEID 
  	AND D.ISUSABLE ='Usable'
INNER JOIN CIM_INSPITEM II
	ON C.INSPITEMID = II.INSPITEMID 
	AND C.SITEID = II.SITEID 
	AND D.ISUSABLE ='Usable'
LEFT OUTER JOIN (
				SELECT VD.VENDORID AS CID, VD.VENDORNAME AS COPERATORNAME, VD.SITEID FROM CIM_VENDOR VD
				UNION ALL
				SELECT CT.CUSTOMERID AS CID, CT.CUSTOMERNAME AS COPERATORNAME, CT.SITEID FROM CIM_CUSTOMER CT
		   ) COP 
	ON D.COPERATOR = COP.CID 
	AND D.SITEID = COP.SITEID
LEFT OUTER JOIN CIM_MATERIALDEFINITION M 
		ON D.ITEMID = M.MATERIALDEFINITIONID 
		AND D.SITEID = M.SITEID 
LEFT OUTER JOIN CIM_MATERIALCLASS MC 
	ON M.MATERIALCLASSID = MC.MATERIALCLASSID 
	AND C.SITEID = M.SITEID
INNER JOIN CIM_CODE CD1
	ON D.INSPTYPE = CD1.CODEID
	AND CD1.CODECLASSID = 'INSPTYPE'
	AND D.SITEID = CD1.SITEID 
LEFT OUTER JOIN CIM_CODE CD2
	ON C.DATATYPE = CD2.CODEID
	AND CD2.CODECLASSID = 'DATATYPE'
	AND C.SITEID = CD2.SITEID
LEFT OUTER JOIN CIM_CODE CD3
	ON C.CALCULATETYPE = CD3.CODEID
	AND CD3.CODECLASSID = 'CALCULATETYPE'
	AND C.SITEID = CD3.SITEID
LEFT OUTER JOIN CIM_CODE CD4
	ON D.INSPSPEC = CD4.CODEID
	AND CD4.CODECLASSID = 'INSPSPEC'
	AND D.SITEID = CD4.SITEID
 WHERE (:COPERATOR = '' OR D.COPERATOR = :COPERATOR)
   AND (:MATERIALCLASSID = '' OR M.MATERIALCLASSID = :MATERIALCLASSID)
   AND (:ITEMID = '' OR D.ITEMID = :ITEMID)
   AND (:INSPTYPE = '' OR D.INSPTYPE = :INSPTYPE)
   AND (:ISUSABLE = '' OR C.ISUSABLE = :ISUSABLE)
   AND C.SITEID = :SITEID
ORDER BY D.INSPDEFINITIONSYSID, D.INSPTYPE, D.ITEMID, D.COPERATOR, D.REV, C.UISEQUENCE, C.INSPDEFINITIONITEMSPECSYSID