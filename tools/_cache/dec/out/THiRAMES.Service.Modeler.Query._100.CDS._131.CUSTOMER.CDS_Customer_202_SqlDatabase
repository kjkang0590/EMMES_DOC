SELECT CUSTOMERID AS CODE,
	   	CUSTOMERNAME AS NAME
	FROM CIM_CUSTOMER
	WHERE (:INSPTYPE = '' OR ('PQC' = UPPER(:INSPTYPE)) OR ('OQC' = UPPER(:INSPTYPE )))
	AND ISUSABLE='Usable' 
	AND SITEID = :SITEID
UNION ALL  
SELECT VENDORID AS CODE,
		VENDORNAME AS NAME
	FROM CIM_VENDOR
	WHERE (:INSPTYPE = '' OR 'IQC' = UPPER(:INSPTYPE ))
	AND ISUSABLE ='Usable' 
	AND SITEID = :SITEID