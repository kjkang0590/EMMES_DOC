SELECT IC.INSPITEMCLASSNAME, II.*
	, dbo.FN_USERNAME(II.SITEID, II.CREATOR) AS CREATOR2
	, dbo.FN_USERNAME(II.SITEID, II.MODIFIER) AS MODIFIER2
  FROM CIM_INSPITEM II
  LEFT JOIN CIM_INSPITEMCLASS IC
    ON IC.INSPITEMCLASSID = II.INSPITEMCLASSID
   AND IC.SITEID = II.SITEID
 WHERE (:INSPITEMCLASSID = '' OR II.INSPITEMCLASSID LIKE :INSPITEMCLASSID + '%')
   AND (:INSPITEMID = '' OR II.INSPITEMID LIKE :INSPITEMID + '%')
   AND (:INSPITEMNAME = '' OR II.INSPITEMNAME LIKE :INSPITEMNAME + '%')
   AND (:ISUSABLE = '' OR II.ISUSABLE = :ISUSABLE)
   AND II.SITEID = :SITEID
ORDER BY II.INSPITEMCLASSID, II.INSPITEMID