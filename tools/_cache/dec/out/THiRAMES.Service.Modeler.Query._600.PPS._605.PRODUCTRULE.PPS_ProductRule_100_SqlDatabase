SELECT C.*, dbo.FN_USERNAME(C.SITEID, C.CREATOR) AS CREATOR2, dbo.FN_USERNAME(C.SITEID, C.MODIFIER) AS MODIFIER2
  FROM CIM_PRODUCTRULE C
 WHERE (:PRODUCTRULESYSID = '' OR PRODUCTRULESYSID LIKE :PRODUCTRULESYSID + '%')
   AND (:PRODUCTRULETYPE = '' OR PRODUCTRULETYPE LIKE :PRODUCTRULETYPE + '%')
   AND (:ISUSABLE = '' OR ISUSABLE = :ISUSABLE)
   AND SITEID = :SITEID