SELECT M.MENUNAME, O.*
  FROM CIM_MENUOBJECT O
 LEFT OUTER JOIN CIM_MENU M 
 	ON O.MENUID = M.MENUID AND O.MENUCLASSID = M.MENUCLASSID AND O.SITEID = M.MENUCLASSID AND M.ISUSABLE ='Usable' AND (M.MENUNAME LIKE :MENUNAME + '%' ) 
 WHERE O.MENUID LIKE :MENUID + '%'
   AND O.MENUCLASSID LIKE :MENUCLASSID + '%'
   AND O.SITEID=:SITEID
   AND (:ISUSABLE='' OR O.ISUSABLE=:ISUSABLE)