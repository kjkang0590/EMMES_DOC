SELECT
	CMD.*,
    CVD.VENDORNAME,
	CMC.MATERIALCLASSNAME ,
	CASE WHEN CI.INSPMETHOD IS NULL THEN CI2.INSPMETHOD ELSE CI.INSPMETHOD END AS INSPMETHOD,
	CASE WHEN CI.INSPMETHOD IS NULL THEN CC3.CODENAME ELSE CC.CODENAME END AS INSPMETHODNAME ,
     CC2.CODENAME  AS RECEIPTUNITTYPENAME
  FROM CIM_MATERIALDEFINITION CMD
  LEFT JOIN CIM_VENDOR CVD
         ON CVD.VENDORID = CMD.VENDORID 
         AND CVD.SITEID = CMD.SITEID
 INNER JOIN CIM_MATERIALCLASS CMC
         ON CMC.MATERIALCLASSID = CMD.MATERIALCLASSID  
	    AND CMC.SITEID = CMD.SITEID
	    AND CMC.ISUSABLE = :ISUSABLE
  LEFT JOIN CIM_INSPDEFINITION CI
		 ON CI.COPERATOR  = CVD.VENDORID
	    AND CI.ITEMID = CMD.MATERIALDEFINITIONID 
	    AND CI.INSPTYPE = 'IQC'
	    AND CI.INSPSPEC = '-'
	    AND CI.STATE = 'Active'
	    AND CI.SITEID = CMD.SITEID
	    AND CI.ISUSABLE = :ISUSABLE
  LEFT JOIN CIM_INSPDEFINITION CI2
		 ON CI2.COPERATOR  = '-' 
	    AND CI2.ITEMID = CMD.MATERIALDEFINITIONID 
	    AND CI2.INSPTYPE = 'IQC'
	    AND CI2.INSPSPEC = '-'
	    AND CI2.STATE = 'Active'
	    AND CI2.SITEID = CMD.SITEID
	    AND CI2.ISUSABLE = :ISUSABLE	    
  LEFT JOIN CIM_CODE CC
         ON CC.CODEID = CI.INSPMETHOD
        AND CC.CODECLASSID  = 'INSPMETHOD'
        AND CC.SITEID = CMD.SITEID
        AND CC.ISUSABLE = :ISUSABLE
 LEFT JOIN CIM_CODE CC2
         ON CC2.CODEID = CMD.RECEIPTUNITTYPE
        AND CC2.CODECLASSID  = 'RECEIPTUNITTYPE'
        AND CC2.SITEID = CMD.SITEID
        AND CC2.ISUSABLE = 'Usable' 
  LEFT JOIN CIM_CODE CC3
         ON CC3.CODEID  = CI2.INSPMETHOD 
        AND CC3.CODECLASSID  = 'INSPMETHOD'
        AND CC3.SITEID  = CMD.SITEID 
        AND CC3.ISUSABLE  = 'Usable'         
 WHERE (:MATERIALCLASSNAME ='' OR CMC.MATERIALCLASSNAME LIKE :MATERIALCLASSNAME + '%')
   AND (:RECEIPTUNITTYPE ='' OR CMD.RECEIPTUNITTYPE = :RECEIPTUNITTYPE)
   AND (:MATERIALDEFINITIONID ='' OR CMD.MATERIALDEFINITIONID LIKE :MATERIALDEFINITIONID + '%')
   AND (:MATERIALDEFINITIONNAME ='' OR CMD.MATERIALDEFINITIONNAME LIKE :MATERIALDEFINITIONNAME + '%')
   AND CMD.PRODUCTTYPE = 'ROH'
   AND (:ISUSABLE ='' OR CMD.ISUSABLE = :ISUSABLE)
   AND (:SITEID ='' OR CMD.SITEID = :SITEID)
 ORDER BY CMD.MATERIALDEFINITIONID 