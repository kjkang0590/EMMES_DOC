SELECT *, dbo.FN_USERNAME(C.SITEID, C.CREATOR) AS CREATOR2, dbo.FN_USERNAME(C.SITEID, C.MODIFIER) AS MODIFIER2
  FROM CIM_IDPATTERN C
 WHERE (:IDPATTERNID = '' OR IDPATTERNID LIKE :IDPATTERNID + '%')
   AND (:IDPATTERNNAME = '' OR IDPATTERNNAME LIKE :IDPATTERNNAME + '%')
   AND (:ISUSABLE = '' OR ISUSABLE = :ISUSABLE)
   AND SITEID = :SITEID