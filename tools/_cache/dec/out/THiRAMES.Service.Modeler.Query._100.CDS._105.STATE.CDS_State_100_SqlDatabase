SELECT C.*, dbo.FN_USERNAME(C.SITEID, C.CREATOR) AS CREATOR2, dbo.FN_USERNAME(C.SITEID, C.MODIFIER) AS MODIFIER2
  FROM CIM_STATE C
 WHERE (:STATEMODELID = '' OR STATEMODELID = :STATEMODELID)
   AND (:STATEID = '' OR STATEID LIKE :STATEID + '%')
   AND (:STATENAME = '' OR STATENAME LIKE :STATENAME + '%')
   AND SITEID = :SITEID
   AND (:ISUSABLE = '' OR ISUSABLE = :ISUSABLE)